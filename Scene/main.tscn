[sub_resource type="GDScript" id="GDScript_c2iwn"]
script/source = "extends Label
func show_notification(message: String): 
	%NotificationLabel.text = message; 
	visible = true; 
	%NotificationBox.visible = true; 
	$HideTimer.start()
	
"

